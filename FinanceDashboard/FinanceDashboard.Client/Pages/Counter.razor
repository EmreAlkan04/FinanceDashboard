@page "/counter"
@using FinanceDashboard.Client.Services
@using static System.Runtime.InteropServices.JavaScript.JSType
@rendermode InteractiveServer
@inject IExpenseService ExpenseService


<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<h3>First 5 entries (from the database)</h3>

@if (dbError is not null)
{
    <div class="alert alert-danger">@dbError</div>
}
else if (firstEntries.Count == 0)
{
    <div class="alert alert-warning">The database has no entries.</div>
}
else
{
    <p>Showing @firstEntries.Count of @totalEntries entries.</p>
    <table class="table table-sm table-striped w-auto">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Category</th>
                <th>Expense</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in firstEntries)
            {
                <tr>
                    <td>@entry.Id</td>
                    <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                    <td>@entry.CategoryName</td>
                    <td>@entry.Expense.ToString("F2") €</td>
                    <td>@(entry.Note ?? "–")</td>
                </tr>
            }
        </tbody>
    </table>
}

<p role="status">

    <h3>Total Cost</h3>
    <div>
        @foreach (var year in AvailableYears)
        {
            <button class="btn @(year == selectedTotalCostYear ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SelectTotalCostYear(year)">
                @year
            </button>
        }
    </div>
    Total cost for @selectedTotalCostYear is: @ExpenseService.TotalCost(selectedTotalCostYear)
    <br>

    Categories:

    @foreach (var category in ChartByeCategory())
    {
        <div>
            <strong>@category.CategoryName: @category.Expense €</strong>
        </div>
    }

    @foreach (var category in PercentageChart())
    {
        <div>
            <strong>@category.CategoryName: @category.Expense %</strong>
        </div>
    }

    <h3>Monthly Expenses</h3>
    <div>
        @foreach (var year in AvailableYears)
        {
            <button class="btn @(year == selectedMonthlyExpenseYear ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SelectMonthlyExpenseYear(year)">
                @year
            </button>
        }
    </div>

    @foreach (var month in MonthlyExpense(selectedMonthlyExpenseYear))
    {
        <div>
            <strong>@month.ToString() € </strong>
        </div>
    }



    <label>
        Enter a double:
        <input type="number" step="0.1" @bind="minValueOnRanking" @bind:event="oninput" />
    </label>
    <button class="btn btn-primary" @onclick="SubmitRanking">Show Ranking</button>

    @foreach (var item in Ranking(submittedMinValueOnRanking))
    {
        <div> @item.Note bought for @item.Expense</div>
    }

</p>


@code {
    private List<string> listRows = new List<string>();

    private List<FinanceDashboard.Model.CategoryModel> firstEntries = new List<FinanceDashboard.Model.CategoryModel>();
    private int totalEntries;
    private string? dbError;

    private List<FinanceDashboard.Model.CategoryModel> categoryModel = new List<FinanceDashboard.Model.CategoryModel>();

    // currently selected years, bound to the buttons below
    private int selectedTotalCostYear = DateTime.Now.Year;
    private int selectedMonthlyExpenseYear = DateTime.Now.Year;
    private double minValueOnRanking = 0.0;
    private double submittedMinValueOnRanking = 0.0;


    // the list of years the buttons are generated from, based on what's actually in the CSV
    private List<int> AvailableYears = new List<int>();

    protected override void OnInitialized()
    {
        var reader = new StreamReader(File.OpenRead(@"C:\\GitHub\\FinanceDashboard\\FinanceDashboard\\FinanceDashboard\\wwwroot\\expenses.csv"));
        while (!reader.EndOfStream)
        {
            listRows.Add(reader.ReadLine());
        }

        foreach (var item in listRows)
        {
            var testname = item.Split(",", 4);
            FinanceDashboard.Model.CategoryModel model = new Model.CategoryModel(testname.GetValue(1).ToString(),
            Convert.ToDouble(testname.GetValue(2).ToString().Replace(".", ",")), DateTime.ParseExact(testname.GetValue(0).ToString(), "yyyy-MM-dd", null), testname.GetValue(3).ToString());
            categoryModel.Add(model);
        }

        AvailableYears = GetAvailableYears();

        if (AvailableYears.Any())
        {
            if (!AvailableYears.Contains(selectedTotalCostYear))
                selectedTotalCostYear = AvailableYears.First();

            if (!AvailableYears.Contains(selectedMonthlyExpenseYear))
                selectedMonthlyExpenseYear = AvailableYears.First();
        }

    }

    // loads the first 5 entries (ordered by Id) from the database to show that the CSV import worked
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // firstEntries = await ExpenseService.GetFirstAsync(5);
            // totalEntries = await ExpenseService.GetCountAsync();
        }
        catch (Exception ex)
        {
            dbError = $"Could not load entries from the database: {ex.Message}";
        }
    }



    // reads the year out of the date column of every row and returns the distinct years found, newest first
    private List<int> GetAvailableYears()
    {
        HashSet<int> years = new HashSet<int>();

        foreach (var row in listRows)
        {
            if (string.IsNullOrWhiteSpace(row)) continue;

            var dateField = row.Split(",", 2).GetValue(0)?.ToString();

            if (!string.IsNullOrEmpty(dateField) && dateField.Length >= 4 &&
                int.TryParse(dateField.Substring(0, 4), out int year))
            {
                years.Add(year);
            }
        }

        return years.OrderByDescending(y => y).ToList();
    }

    private void SelectTotalCostYear(int year)
    {
        selectedTotalCostYear = year;
        // Blazor re-renders the component automatically after a UI event handler runs,
        // so no manual StateHasChanged() call or page reload is needed here.
    }

    private void SelectMonthlyExpenseYear(int year)
    {
        selectedMonthlyExpenseYear = year;
    }

    private void SubmitRanking()
    {
        submittedMinValueOnRanking = minValueOnRanking;
        // Blazor re-renders after the click handler runs, so the Ranking()
        // loop below picks up the new value immediately, no reload needed.
    }


    // private double TotalCost(int? year = null)
    // {
    //     year ??= DateTime.Now.Year;

    //     double totalExpense = 0;
    //     foreach (var item in categoryModel.Where(s => s.Date.Year.Equals(year)))
    //     {
    //         // var testname = item.Split(",", 4);

    //         double expense = Convert.ToDouble(item.Expense.ToString().Replace(".", ","));
    //         // Int32.TryParse(testname.GetValue(2).ToString(), out expense);
    //         totalExpense += expense;
    //     }

    //     totalExpense = Math.Round(totalExpense, 2);

    //     return totalExpense;
    // }

    private List<FinanceDashboard.Model.CategoryModel> ChartByeCategory()
    {
        HashSet<string> catNames = new HashSet<string>();
        List<FinanceDashboard.Model.CategoryModel> test = new List<FinanceDashboard.Model.CategoryModel>();

        foreach (var item in categoryModel)
        {
            // string cat = item.Split(",", 3)[1];
            catNames.Add(item.CategoryName);
        }

        foreach (var categoryItem in catNames)
        {
            double catExpense = 0;
            List<string> catEntries = listRows.Where(s => s.Contains(categoryItem)).ToList();

            foreach (var item in catEntries)
            {
                var testname = item.Split(",", 4);

                double expense = Convert.ToDouble(testname.GetValue(2).ToString().Replace(".", ","));
                // Int32.TryParse(testname.GetValue(2).ToString(), out expense);
                catExpense += expense;
            }

            catExpense = Math.Round(catExpense, 2);
            test.Add(new Model.CategoryModel(categoryItem, catExpense));
        }

        test = test.OrderByDescending(s => s.Expense).ToList();

        return test;
    }

    private List<double> MonthlyExpense(int? year = null)
    {
        year ??= DateTime.Now.Year;

        DateTime target = new DateTime(year ?? DateTime.Now.Year, 1, 1);
        List<double> montlyExpensesList = new List<double>();

        for (var i = 1; i <= DateTime.Now.Month; i++)
        {
            double montly = 0.0;
            foreach (var montlyExpense in categoryModel.Where(s => s.Date.Year.Equals(target.Year) && s.Date.Month.Equals(target.AddMonths(i - 1).Month)))
            {
                // var testname = montlyExpense.Split(",", 4);

                double expense = Convert.ToDouble(montlyExpense.Expense.ToString().Replace(".", ","));
                // Int32.TryParse(testname.GetValue(2).ToString(), out expense);
                montly += expense;

            }
            montly = Math.Round(montly, 2);

            montlyExpensesList.Add(montly);
        }

        return montlyExpensesList;
    }

    private List<FinanceDashboard.Model.CategoryModel> PercentageChart()
    {
        List<FinanceDashboard.Model.CategoryModel> percentages = new List<FinanceDashboard.Model.CategoryModel>();
        var total = ExpenseService.TotalCost();

        foreach (var item in ChartByeCategory())
        {
            var irtgendwas = (item.Expense / total) * 100;
            irtgendwas = Math.Round(irtgendwas, 2);
            FinanceDashboard.Model.CategoryModel model = new Model.CategoryModel(item.CategoryName, irtgendwas);
            percentages.Add(model);
        }

        return percentages;
    }

    private List<FinanceDashboard.Model.CategoryModel> Ranking(double? minExp = 00.00)
    {
        List<FinanceDashboard.Model.CategoryModel> ranked = new List<FinanceDashboard.Model.CategoryModel>();

        foreach (var item in categoryModel.Where(s => s.Expense >= minExp && s.CategoryName != "Lebensmittel").OrderByDescending(s => s.Expense))
            ranked.Add(item);

        return ranked;
    }
}
