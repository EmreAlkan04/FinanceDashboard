@page "/counter"
@* @rendermode InteractiveServer *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using FinanceDashboard.Client.Components
@using FinanceDashboard.Client.Services
@using FinanceDashboard.Model
@using System.Net
@* @using ApexCharts; *@
@using MudBlazor;
@inject IExpenseService ExpenseService

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <section>
        <YearSelector Years="availableYears" SelectedYear="universalYear" OnSelected="SelectUniversalYear" />

        <section class="mb-5">
            <h3>First @FirstEntriesCount entries</h3>

            @if (totalEntries == 0)
            {
                <div class="alert alert-warning">The database has no entries yet.</div>
            }
            else
            {
                <p>Showing @firstEntries.Count of @totalEntries entries.</p>
                <table class="table table-sm table-striped w-auto">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th class="text-end">Expense</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in firstEntries)
                        {
                            <tr>
                                <td>@entry.Id</td>
                                <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                                <td>@entry.Category</td>
                                <td class="text-end">@Money(entry.Expense)</td>
                                <td>@(entry.Note ?? "–")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="mb-5">
            <h3>Total cost</h3>
            <p>Total cost for @universalYear: <strong>@Money(totalCost)</strong></p>
        </section>

        <section class="mb-5">
            <h3>Categories</h3>
            <table class="table table-sm table-striped w-auto">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in categories)
                    {
                        <tr>
                            <td>@row.Category</td>
                            <td class="text-end">@Money(row.Total)</td>
                            <td class="text-end">@Percent(row.Percent)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div>
                @* <ApexChart TItem="CategoryRow" Title="Expenses per Category" @ref="categoryChartBla">
            <ApexPointSeries TItem="CategoryRow"
            Items="categories"
            Name="Categories"
            SeriesType="SeriesType.Donut"
            XValue="@(m => m.Category)"
            YValue="@(m => (decimal)m.Percent)" />
            </ApexChart> *@

                <MudChart T="double" ChartType="ChartType.Donut" Width="100%" Height="300px" ChartSeries="@DataCategories.AsChartDataSet()" ChartLabels="@Labels">
                    <CustomGraphics>
                        <text class="mud-donut-text mud-typography-h3" x="50%" y="50%">@DataCategories.Sum()</text>
                    </CustomGraphics>
                </MudChart>
            </div>

        </section>

        <section class="mb-5">
            <h3>Monthly expenses</h3>
            <table class="table table-sm table-striped w-auto">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th class="text-end">Expenses</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var month = 1; month <= monthlyExpenses.Count; month++)
                    {
                        <tr>
                            <td>@MonthName(month)</td>
                            <td class="text-end">@Money(monthlyExpenses[month - 1])</td>
                        </tr>
                    }
                </tbody>
            </table>

            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_series" ChartLabels="@_xAxisLabels"
                      ChartOptions="@_options" Width="100%" Height="350px" />

        </section>

        <section class="mb-5">
            <h3>Ranking</h3>
            <div class="mb-3">
                <label class="form-label" for="min-expense">Minimum expense (€)</label>
                <div class="input-group w-auto">
                    <input id="min-expense" class="form-control" type="number" step="0.1"
                           @bind="minRankingExpense" @bind:event="oninput" />
                    <button type="button" class="btn btn-primary" @onclick="ShowRanking">Show ranking</button>
                </div>
            </div>

            @if (ranking.Count == 0)
            {
                <p class="text-muted">No entries with a note cost at least @(Money(minRankingExpense)).</p>
            }
            else
            {
                <table class="table table-sm table-striped w-auto">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Date</th>
                            <th class="text-end">Expense</th>
                            <th>Image</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var rank = 1; rank <= Math.Min(ranking.Count, RankingRowsShown); rank++)
                        {
                            var item = ranking[rank - 1];
                            string? imageSrc = item.Image is { Length: > 0 } imageBytes
                            ? $"data:image/jpeg;base64,{Convert.ToBase64String(imageBytes)}"
                            : null;

                            <tr>
                                <td>@rank</td>
                                <td>@item.Note</td>
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">@Money(item.Expense)</td>
                                <td>
                                    @if (imageSrc is not null)
                                    {
                                        <img src="@imageSrc"
                                             alt="@item.Note"
                                             style="max-width: 100px; max-height: 100px; object-fit: contain;"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (ranking.Count > RankingRowsShown)
                {
                    <p class="text-muted">... and @(ranking.Count - RankingRowsShown) more.</p>
                    <button type="button" @onclick="ShowMoreFromRanking">Show more entries</button>
                }
            }
        </section>
    </section>
}

@code {
    private const int FirstEntriesCount = 5;
    private int RankingRowsShown = 10;

    // One row of the category table. Total and share come from two separate service calls.
    private record CategoryRow(string Category, double Total, double Percent);
    private record MonthlyChartDTO(string Month, double Expense);

    private bool isLoading = true;
    private string? errorMessage;

    private List<ExpensesModel> firstEntries = new();
    private int totalEntries;

    private List<int> availableYears = new();

    private int universalYear;
    private double totalCost;

    private List<CategoryRow> categories = new();

    private List<double> monthlyExpenses = new();

    private double minRankingExpense;
    private List<ExpensesModel> ranking = new();

    // private List<MonthlyChartDTO> monthlyChart = new();
    // private ApexChart<MonthlyChartDTO>? monthlyChartBla;

    // private ApexChart<CategoryRow> categoryChartBla;

    private readonly BarChartOptions _options = new() { ShowValues = true };

    //Mudblazor components
    private List<ChartSeries<double>> _series = new(); /* { Name = "United States", Data = new double[] { 40, 20, 25, 27, 46 } } */
    private string[] _xAxisLabels;
    private static double[] DataCategories; /* [25, 77, 28, 5]; */
    private static string[] Labels; /* ["Oil", "Coal", "Gas", "Biomass"]; */

    protected override async Task OnInitializedAsync()
    {
        try
        {
            firstEntries = ExpenseService.GetFirst(FirstEntriesCount);
            totalEntries = ExpenseService.GetCount();
            availableYears = (await ExpenseService.GetAllYears()).OrderByDescending(year => year).ToList();

            universalYear = PickInitialYear();

            LoadTotalCost();
            LoadCategories();
            LoadMonthlyExpenses();
            // await LoadMissingImages();
            LoadRanking(); // last: if it fails, the rest of the page is already filled

        }
        catch (Exception ex)
        {
            ReportError(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void LoadTotalCost() =>
        totalCost = ExpenseService.TotalExpenseOfTheYear(universalYear);

    private void LoadCategories()
    {
        // PercentageChart() returns the share in the Expense property; it is given a proper name here.
        @* var shares = ExpenseService.PercentageChart().ToDictionary(item => item.Category, item => item.Expense); *@

        // var blal = ExpenseService.ExpenseByCategory(universalYear);
        categories.Clear();
        foreach (var item in ExpenseService.ExpenseByCategory(universalYear))
        {
            var percent = totalCost > 0 ? item.Expense / totalCost * 100 : 0;
            categories.Add(new CategoryRow(item.Category, item.Expense, Math.Round(percent, 2)));
        }
        @*         categories = ExpenseService.ExpenseByCategory(universalYear)
        .Select(item => new CategoryRow(item.Category, item.Expense, )
            .ToList();
 *@
        DataCategories = categories.Select(s => s.Total).ToArray();
        Labels = categories.Select(s => s.Category).ToArray();
    }

    private void LoadMonthlyExpenses()
    {
        monthlyExpenses = ExpenseService.MonthlyExpense(universalYear);

        _xAxisLabels = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
        _series.Clear();
        _series.Add(new()
            {
                Name = $"Expenses for the year {universalYear}",
                Data = monthlyExpenses.ToArray()
            });

        // _series.Data = monthlyExpenses.ToArray();
        // _series.Name = $"Expenses for the Year {universalYear}";


        // for (int month = 1; month <= CultureInfo.CurrentCulture.DateTimeFormat.)
        @*         monthlyChart.Clear();
        for (int i = 1; i <= monthlyExpenses.Count; i++)
        {
            string monthName = MonthName(i);
            double expense = monthlyExpenses[i - 1];
            monthlyChart.Add(new MonthlyChartDTO(monthName, expense));
        }
 *@     }

    private async Task LoadMissingImages() => await ExpenseService.ImageReceiverAsync();

    private void LoadRanking() =>
        ranking = ExpenseService.Ranking(minRankingExpense, universalYear);

    private void SelectTotalCostYear(int year)
    {
        universalYear = year;
        Reload(LoadTotalCost);
    }

    private async Task SelectUniversalYear(int year)
    {
        universalYear = year;
        Reload(LoadTotalCost);
        Reload(LoadCategories);
        Reload(LoadMonthlyExpenses);
        Reload(LoadRanking);

        @* await UpdateApexChart(); *@
    }

    @*     private async Task UpdateApexChart()
    {
        if (monthlyChart is not null)
            await monthlyChartBla.UpdateSeriesAsync(animate: true);

        if (categories is not null)
            await categoryChartBla.UpdateSeriesAsync(animate: true);
    } *@

    private void ShowRanking()
    {
        RankingRowsShown = 10;
        Reload(LoadRanking);
    }
    private void ShowMoreFromRanking() => RankingRowsShown += 10;

    private void Reload(Action loader)
    {
        try
        {
            errorMessage = null;
            loader();
        }
        catch (Exception ex)
        {
            ReportError(ex);
        }
    }

    private void ReportError(Exception ex) =>
        errorMessage = $"Could not load data from the database: {ex.Message}";

    private int PickInitialYear() =>
        availableYears.Count == 0 || availableYears.Contains(DateTime.Now.Year)
            ? DateTime.Now.Year
            : availableYears[0];


    private static string Money(double value) => $"{value:N2} €";

    private static string Percent(double value) => double.IsFinite(value) ? $"{value:N2} %" : "–";

    private static string MonthName(int month) =>
        CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);
}
